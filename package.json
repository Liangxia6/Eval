{
  "name": "dsheval-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "dsheval": "./dist/src/app/cli.js",
    "dsheval-viewer": "./dist/src/app/viewer-cli.js",
    "dsheval-dynamic": "./dist/src/dynamic/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "cli": "node dist/src/app/cli.js",
    "viewer": "node dist/src/app/viewer-cli.js",
    "dynamic": "node dist/src/dynamic/cli.js",
    "test:dynamic": "pnpm run build && node scripts/run-tests.mjs dynamic",
    "test": "pnpm run build && node scripts/run-tests.mjs"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "typescript": "5.9.3"
  }
}
