{
  "profile": "fixture-filesystem",
  "probe": {
    "schema": "dsh-eval.probe/v1",
    "order": "before-headless",
    "captureDispatch": true,
    "captureLogs": true
  },
  "plugins": [
    {
      "id": "fixture.filesystem-tool",
      "version": "1.0.0"
    }
  ],
  "permissionPreset": "fixture-workspace-only",
  "sandboxMode": "fixture-process"
}
